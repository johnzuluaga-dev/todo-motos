# Copia este archivo como ".env" (no lo renombres) y llena los valores.
# NUNCA subas el archivo .env a GitHub ni lo compartas.

# ── Servidor ───────────────────────────────
PORT=3000

# ── Supabase ───────────────────────────────
# Project Settings -> API: URL del proyecto
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings -> API Keys: clave secreta "sb_secret_..." (o "service_role"). Es SECRETA.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ─────────────────────────────
# Console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Panel de administración (/admin) ───────
# La contraseña que tú quieras usar para entrar al panel
ADMIN_PASSWORD=
# Una cadena larga y aleatoria (mínimo 32 caracteres). Para generarla:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── WhatsApp ───────────────────────────────
# Número con código de país, solo dígitos (Colombia = 57). Ejemplo: 573001234567
WHATSAPP_NUMBER=573000000000
# Saludo con el que empieza el mensaje del pedido
WHATSAPP_GREETING=Hola Todo Motos 👋, quiero cotizar los siguientes productos:
